@php
    // [label, ikon, nama route, pola route aktif]
    // Menu yang route-nya belum ada (Fase 3) tampil redup dengan label "Segera".
    $menu = [
        ['Dashboard',   '🏠', 'admin.dashboard',         'admin.dashboard'],
        ['Properti',    '🏢', 'admin.properties.index',  'admin.properties.*'],
        ['Kamar',       '🛏️', 'admin.rooms.index',       'admin.rooms.*'],
        ['Penghuni',    '👥', 'admin.tenants.index',     'admin.tenants.*'],
        ['Tagihan',     '🧾', 'admin.invoices.index',    'admin.invoices.*'],
        ['Pembayaran',  '💳', 'admin.payments.index',    'admin.payments.*'],
        ['Leads',       '📨', 'admin.leads.index',       'admin.leads.*'],
        ['Maintenance', '🛠️', 'admin.maintenances.index','admin.maintenances.*'],
        ['Perpanjangan','🔁', 'admin.extensions.index',  'admin.extensions.*'],
        ['Pengaturan',  '⚙️', 'admin.settings.index',    'admin.settings.*'],
    ];

    // Breadcrumb otomatis dari nama route, mis. admin.properties.create => Admin > Properti > Tambah
    $resourceLabels = [
        'dashboard' => 'Dashboard', 'properties' => 'Properti', 'rooms' => 'Kamar', 'tenants' => 'Penghuni',
        'invoices' => 'Tagihan', 'payments' => 'Pembayaran', 'leads' => 'Leads', 'maintenances' => 'Maintenance',
        'extensions' => 'Perpanjangan', 'settings' => 'Pengaturan',
    ];
    $actionLabels = ['create' => 'Tambah', 'edit' => 'Edit', 'show' => 'Detail'];

    $parts  = explode('.', request()->route()?->getName() ?? '');
    $crumbs = [['Admin', route('admin.dashboard')]];
    $resource = $parts[1] ?? 'dashboard';

    if ($resource !== 'dashboard') {
        $crumbs[] = [
            $resourceLabels[$resource] ?? ucfirst($resource),
            Route::has("admin.{$resource}.index") ? route("admin.{$resource}.index") : null,
        ];
    } else {
        $crumbs[] = ['Dashboard', null];
    }
    if (isset($parts[2], $actionLabels[$parts[2]])) {
        $crumbs[] = [$actionLabels[$parts[2]], null];
    }
@endphp

